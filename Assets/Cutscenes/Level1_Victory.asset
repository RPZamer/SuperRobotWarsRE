MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1bd3be70ca96bae41afa4b68d83c5026, type: 3}
  m_Name: Level1_Victory
  m_EditorClassIdentifier: Assembly-CSharp::CutsceneData
  cutsceneName: Level 1- Victory
  lines:
  - pilot: {fileID: 11400000, guid: b06bacec7d0355448a4bb23bac5f4496, type: 2}
    emotion: 0
    speakerNameOverride: 
    dialogue: Hah Hah! Serves them right! So where to now?
    showPortrait: 1
  - pilot: {fileID: 11400000, guid: c7a96261f43436c4abb7b9c0ce8c4086, type: 2}
    emotion: 0
    speakerNameOverride: 
    dialogue: Well Char is with Zeon, and Zeon is in space, so I'm guessing that we need to go there?
    showPortrait: 1
  - pilot: {fileID: 11400000, guid: 3e44d288864a64349b6d1bdcc7bc827b, type: 2}
    emotion: 0
    speakerNameOverride: 
    dialogue: But we would need a ship to get to space, so we would need to go there to get that accomplished.
    showPortrait: 1
  - pilot: {fileID: 11400000, guid: c7a96261f43436c4abb7b9c0ce8c4086, type: 2}
    emotion: 0
    speakerNameOverride: 
    dialogue: No, I don't think so. Something about it not fitting in with the time they had to complete the demo, or the lack of sprites or something.
    showPortrait: 1
  - pilot: {fileID: 11400000, guid: ae3af38c8b715514e99a2923e7974548, type: 2}
    emotion: 0
    speakerNameOverride: 
    dialogue: What do we do then?
    showPortrait: 1
  - pilot: {fileID: 11400000, guid: 6c5c9a7f2695ae34ba63db5ad62a57dc, type: 2}
    emotion: 0
    speakerNameOverride: 
    dialogue: I think I know where we can go.
    showPortrait: 1
  - pilot: {fileID: 11400000, guid: b06bacec7d0355448a4bb23bac5f4496, type: 2}
    emotion: 0
    speakerNameOverride: 
    dialogue: Well if you got a plan, I'll gather Tetsuya and the others and we can go there!
    showPortrait: 1
  transitionToScene: 0
  destinationScene: 
