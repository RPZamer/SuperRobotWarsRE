  m_Script: {fileID: 11500000, guid: 1bd3be70ca96bae41afa4b68d83c5026, type: 3}
  m_Name: Level5_Victory
  m_EditorClassIdentifier: Assembly-CSharp::CutsceneData
  cutsceneName: Level 5 - Victory
  lines:
  - pilot: {fileID: 11400000, guid: 4eaa01649e68c3e4bb9a59c04a541ec4, type: 2}
    emotion: 0
    speakerNameOverride: 
    dialogue: You have all done well...
    showPortrait: 1
  - pilot: {fileID: 11400000, guid: c7a96261f43436c4abb7b9c0ce8c4086, type: 2}
    emotion: 0
    speakerNameOverride: 
    dialogue: Char...
    showPortrait: 1
  - pilot: {fileID: 11400000, guid: 4eaa01649e68c3e4bb9a59c04a541ec4, type: 2}
    emotion: 0
    speakerNameOverride: 
    dialogue: Now I see that all of you are ready, please await more in the future.
    showPortrait: 1
  - pilot: {fileID: 11400000, guid: 3e44d288864a64349b6d1bdcc7bc827b, type: 2}
    emotion: 0
    speakerNameOverride: 
    dialogue: And whatever comes our way we will be ready for it.
    showPortrait: 1
  - pilot: {fileID: 11400000, guid: b06bacec7d0355448a4bb23bac5f4496, type: 2}
    emotion: 0
    speakerNameOverride: 
    dialogue: And we will be ready for this Super Robot War.
    showPortrait: 1
  - pilot: {fileID: 11400000, guid: b4972229f68a26b4ca5272812f5d9743, type: 2}
    emotion: 0
    speakerNameOverride: 
    dialogue: And when you see us again, I'll have my Akito.
    showPortrait: 1
  - pilot: {fileID: 11400000, guid: c7a96261f43436c4abb7b9c0ce8c4086, type: 2}
    emotion: 0
    speakerNameOverride: 
    dialogue: And the White Base will have its full crew.
    showPortrait: 1
  - pilot: {fileID: 11400000, guid: b06bacec7d0355448a4bb23bac5f4496, type: 2}
    emotion: 0
    speakerNameOverride: 
    dialogue: And we will all be there to save the world.
    showPortrait: 1
  - pilot: {fileID: 11400000, guid: b06bacec7d0355448a4bb23bac5f4496, type: 2}
    emotion: 0
    speakerNameOverride: Everyone
    dialogue: Yeah!
    showPortrait: 0
  transitionToScene: 1
  destinationScene: Credits
